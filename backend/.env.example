# Google Gemini API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Get at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_FAST=qwen/qwen3.8-27b

# MongoDB Connection String (Atlas or local)
MONGODB_URI=your_mongodb_connection_string_here

# JWT Secret for Session Token Signing
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP for OTP verification emails
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# Port (default: 5000)
PORT=5000
